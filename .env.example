# Copy to .env and adjust. Every value here is a placeholder or a safe local default.
# Never commit .env.

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=gateway
DATABASE_URL=postgresql://app:change-me-local-only@postgres:5432/gateway
PG_HOST_PORT=5455

# --- WhatsApp Cloud API ---
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_VERIFY_TOKEN=replace-with-verify-token
# mock = write replies to the outbox and log them; graph = Graph API sender stub (not exercised)
WHATSAPP_MODE=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Admin ---
ADMIN_TOKEN=replace-with-long-random-admin-token
# Allows POST /admin/reset-mock-data (used by the load script). Never true in production.
ALLOW_RESET=true

# --- Mock lab ---
LAB_BASE_URL=http://mocklab:8100
LAB_FAILURE_RATE=0.2
LAB_LATENCY_MIN_MS=300
LAB_LATENCY_MAX_MS=1500
LAB_ENFORCE_IDEMPOTENCY=false
LAB_ENFORCE_CAPACITY=false
LAB_SEED=42

# --- LLM ---
# mock = deterministic, zero cost (default). real = calls the provider below, behind the budget guard.
LLM_MODE=mock
# gemini (Gemini's OpenAI-compatible endpoint) | openai (any OpenAI-compatible endpoint) | anthropic
LLM_PROVIDER=gemini
# Cheapest Flash-class model available to new keys with function calling (checked live 2026-11-21;
# gemini-2.5-flash-lite returned 404 "no longer available to new users"). Models:
# https://aistudio.google.com/docs/models  Pricing: https://aistudio.google.com/docs/pricing
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Your Gemini key (AI Studio). Read only by the worker container. API_KEY and LLM_API_KEY are aliases.
API_KEY=
# free | paid: the key's billing tier; only changes what `make spend` reports as billed.
LLM_BILLING_TIER=free
# Hard cap on recorded real spend (USD, paid-equivalent), summed from llm_spend_ledger.
LLM_BUDGET_USD=2.00
USD_INR=88.0

# --- Worker ---
WORKER_CONCURRENCY=8

# --- Rate limit (token bucket per phone) ---
RATE_LIMIT_CAPACITY=6
RATE_LIMIT_REFILL_PER_SEC=0.1

# --- Host ports ---
API_HOST_PORT=8000
LAB_HOST_PORT=8100
